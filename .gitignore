*.aux
*.log
*.toc
*.lof
*.lot
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.dvi
*.xdv
*.bbl
*.blg
*.bcf
*.run.xml
*.idx
*.ind
*.ilg
*.glg
*.glo
*.gls
*.glsdefs
*.acn
*.acr
*.alg
*.nav
